{
  "name": "lim-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI Gameplay Clip Editor desktop companion",
  "author": "LIM contributors",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "stage": "node scripts/build.cjs --stage-only",
    "start": "electron .",
    "build": "node scripts/build.cjs",
    "build:dry": "node scripts/build.cjs --dry-run"
  },
  "devDependencies": {"electron": "44.7.0", "electron-builder": "26.15.3"},
  "build": {
    "appId": "org.lim.editor",
    "productName": "LIM Editor",
    "directories": {"output": "release"},
    "files": ["*.cjs", "settings.html", "settings.js", "package.json"],
    "extraResources": [{"from": "stage", "to": "runtime"}, {"from": "sidecar.py", "to": "runtime/sidecar.py"}, {"from": "requirements.txt", "to": "runtime/desktop-requirements.txt"}],
    "win": {"target": "nsis"},
    "mac": {"target": "dmg", "category": "public.app-category.video"},
    "linux": {"target": "AppImage", "category": "AudioVideo"}
  }
}
